{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Fetchpad on Project app",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "C:/Users/Admin/Desktop/Project app"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
